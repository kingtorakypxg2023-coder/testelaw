# ==========================================================
#  CONFIGURAÇÃO DE AMBIENTE - Monitor de Diários Oficiais
#  Copie este arquivo para `.env` e preencha com suas chaves.
#  IMPORTANTE: NUNCA faça commit do arquivo `.env` real.
# ==========================================================

# --- Aplicação ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Etapa 1: Captura (Diários Oficiais) ---
# Provedor ativo: jusbrasil | mock  (use "mock" para testar sem credenciais)
CAPTURE_PROVIDER=mock
ESCAVADOR_API_KEY=sua_chave_escavador_aqui
JUSBRASIL_API_KEY=sua_chave_jusbrasil_aqui
# Endpoint da API Jusbrasil (CONFIRMAR na documentação oficial / contrato da API)
JUSBRASIL_API_BASE_URL=https://api.jusbrasil.com.br
JUSBRASIL_SEARCH_PATH=/v1/publicacoes/busca

# Alvos de monitoramento (cada lista separada por vírgula) ------------------
# Nomes/termos livres.            Ex.: "Fulano Advogados,Maria de Souza"
MONITOR_TERMS=
# Inscrições da OAB (NUMERO/UF).  Ex.: "123456/SP,98765/RJ"
MONITOR_OAB=
# Números de processo (CNJ).      Ex.: "1001234-56.2024.8.26.0100"
MONITOR_PROCESSOS=

# --- Etapa 2: Inteligência Artificial ---
# Provedor ativo: claude | gemini | openai | mock  (use "mock" p/ rodar sem credenciais)
AI_PROVIDER=claude
# Claude / Anthropic (provedor padrão)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
# Modelo: claude-haiku-4-5 (padrão: rápido/econômico p/ alto volume) | claude-sonnet-4-6 | claude-opus-4-8 (máxima qualidade)
CLAUDE_MODEL=claude-haiku-4-5
# Google Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
# OpenAI
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# --- Etapa 3: Integração / Agenda (Google Calendar) ---
# Provedor ativo: google | mock  (use "mock" para rodar sem credenciais)
AGENDA_PROVIDER=mock
# Caminho para o JSON de credenciais OAuth baixado do Google Cloud Console
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
GOOGLE_CALENDAR_ID=primary
# Antecedência (em dias) para criar lembretes antes da data fatal do prazo
DEADLINE_REMINDER_DAYS=5

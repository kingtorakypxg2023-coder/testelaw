# ==========================================================
#  CONFIGURAÇÃO DE AMBIENTE - Monitor de Diários Oficiais
#  Copie este arquivo para `.env` e preencha com suas chaves.
#  IMPORTANTE: NUNCA faça commit do arquivo `.env` real.
# ==========================================================

# --- Aplicação ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Etapa 1: Captura (Diários Oficiais) ---
ESCAVADOR_API_KEY=sua_chave_escavador_aqui
JUSBRASIL_API_KEY=sua_chave_jusbrasil_aqui
# Termos/nomes monitorados separados por vírgula
# Ex.: "Fulano Advogados Associados,123.456.789-00,0000000-00.2024.8.26.0100"
MONITOR_TERMS=

# --- Etapa 2: Inteligência Artificial ---
AI_PROVIDER=gemini             # gemini | openai
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# --- Etapa 3: Integração / Agenda (Google Calendar) ---
# Caminho para o JSON de credenciais OAuth baixado do Google Cloud Console
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
GOOGLE_CALENDAR_ID=primary
# Antecedência (em dias) para criar lembretes antes da data fatal do prazo
DEADLINE_REMINDER_DAYS=5

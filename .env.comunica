# =====================================================================
#  PRESET: Captura GRATUITA via DJEN/Comunica (CNJ) — sem credenciais
#
#  Uso:   cp .env.comunica .env   e ajuste MONITOR_OAB
#  Rode:  python -m src.healthcheck   e   python -m src.main
#
#  Este arquivo é um MODELO — contém apenas placeholders.
#  NUNCA coloque segredos/chaves aqui (use o .env, que é gitignored).
# =====================================================================

# --- Aplicação ---
APP_ENV=production
LOG_LEVEL=INFO

# --- Etapa 1: Captura (GRATUITA — DJEN/CNJ, sem credencial) ---
CAPTURE_PROVIDER=comunica
COMUNICA_API_BASE_URL=https://comunicaapi.pje.jus.br
COMUNICA_SEARCH_PATH=/api/v1/comunicacao
# Alvos monitorados (preencha com os seus) -----------------------------
MONITOR_OAB=123456/SP
MONITOR_PROCESSOS=
MONITOR_TERMS=

# --- Etapa 2: Inteligência Artificial ---
# 'mock' roda sem custo/credencial (extrai prazos por heurística do texto real).
# Para extração com IA, troque para 'claude' (ou gemini/openai) e informe a chave.
AI_PROVIDER=mock
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
# CLAUDE_MODEL=claude-haiku-4-5

# --- Etapa 3: Agenda ---
# 'mock' apenas registra em log. Para criar eventos reais no Google Calendar,
# troque para 'google' e configure as credenciais OAuth.
AGENDA_PROVIDER=mock
DEADLINE_REMINDER_DAYS=5
# AGENDA_PROVIDER=google
# GOOGLE_CALENDAR_CREDENTIALS=credentials.json

# --- Notificações ---
# 'mock' registra em log. Troque para webhook/telegram/email para alertar de verdade.
NOTIFIER=mock
NOTIFY_ONLY_URGENT=true

# --- Persistência & Agendamento ---
STATE_STORE=sqlite
STATE_DB_PATH=data/monitor.db
SCHEDULE_INTERVAL_SECONDS=3600
